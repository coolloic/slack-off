;; dev-command
(version 1)
(allow default)
(deny signal)
(allow signal (target same-sandbox))
(deny network-outbound (remote tcp "*:4317") (remote tcp "*:5173") (remote tcp "*:9229") (remote tcp "*:9230") (remote tcp "*:2375") (remote tcp "*:2376") (remote tcp "*:18789") (remote tcp "*:18790") (remote tcp "*:18791") (remote tcp "*:18792") (remote tcp "*:63342") (remote tcp "*:9222"))
(deny network-bind (local tcp "*:4317") (local tcp "*:5173") (local tcp "*:9229") (local tcp "*:9230") (local tcp "*:2375") (local tcp "*:2376") (local tcp "*:18789") (local tcp "*:18790") (local tcp "*:18791") (local tcp "*:18792") (local tcp "*:63342") (local tcp "*:9222"))
(deny mach-lookup (global-name-prefix "com.apple.coreservices.") (global-name-prefix "com.apple.lsd.") (global-name "com.apple.launchservicesd") (global-name "com.apple.pasteboard.1"))
(deny mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc") (global-name-prefix "com.apple.securityd.") (global-name-prefix "com.apple.security.agent") (global-name "com.apple.security.KeychainStasher") (global-name "com.apple.security.kcsharing") (global-name "com.apple.security.octagon") (global-name "com.apple.security.cloudkeychainproxy3") (global-name "com.apple.keychainsharingmessagingd"))
(deny appleevent-send)
(deny network-outbound (remote unix-socket))
(allow network-outbound (remote unix-socket (literal (param "MDNS_SOCKET"))) (remote unix-socket (subpath (param "WRITE_n"))) (remote unix-socket (subpath (param "WRITE_n"))) (remote unix-socket (subpath (param "TICKET_CACHE"))))
(deny network-outbound (remote unix-socket (prefix (param "TMUX_TMP"))) (remote unix-socket (prefix (param "CLAUDE_TMP"))) (remote unix-socket (prefix (param "LAUNCHD_TMP"))) (remote unix-socket (subpath (param "GROUP_CONTAINERS"))) (remote unix-socket (subpath (param "HOME_DOCKER"))))
(allow network-outbound (remote unix-socket (subpath (param "WRITE_n"))) (remote unix-socket (subpath (param "WRITE_n"))) (remote unix-socket (subpath (param "TICKET_CACHE"))))
(deny network-outbound (remote unix-socket (subpath (param "AGENT_SOCK_DIR"))) (remote unix-socket (subpath (param "HOME_GNUPG_SOCKETS"))))
(deny file-write*)
(allow file-write* (subpath (param "TMP_n")) (literal (param "DEV_NULL")) (literal (param "DEV_ZERO")) (literal (param "DEV_TTY")) (subpath (param "DEV_FD")))
(deny file-write-unlink (subpath (param "TMP_n")))
(deny file-read* file-write* (subpath (param "HOME_SSH")) (subpath (param "HOME_GH")) (subpath (param "HOME_AWS")) (literal (param "HOME_NPMRC")) (literal (param "HOME_NETRC")) (subpath (param "HOME_KEYCHAINS")) (subpath (param "CHROME_PROFILES")) (literal (param "HOME_GIT_CREDENTIALS")) (literal (param "HOME_GIT_CONFIG_CREDENTIALS")) (subpath (param "HOME_GNUPG")) (literal (param "HOME_DOCKER_CONFIG")) (subpath (param "HOME_KUBE")) (subpath (param "ARC_PROFILES")) (subpath (param "BRAVE_PROFILES")) (subpath (param "FIREFOX_PROFILES")) (subpath (param "EDGE_PROFILES")) (literal (param "SLACKOFF_CREDENTIALS")) (subpath (param "SLACKOFF_HOME")))
(deny file-read* file-write* (prefix (param "CLAUDE_TMP")))
(deny file-read* file-write* (prefix (param "HOME_CLAUDE_JSON")) (prefix (param "HOME_CLAUDE_JSON_NAME")))
(allow file-read-metadata (literal (param "HOME_UP_n")))
(allow file-write-create file-write-data (require-all (regex (param "CLAUDE_CWD_RE")) (vnode-type REGULAR-FILE)))
(allow file-read* (subpath (param "HOME_ALLOW")))
(allow file-write* (subpath (param "WRITE_n")))
(allow file-read* file-write* (subpath (param "TICKET_CACHE")))
(allow file-write-unlink (subpath (param "WRITE_n")) (subpath (param "TICKET_CACHE")))
(allow file-read-metadata (literal (param "HOME_ALLOW_UP_n")) (literal (param "TICKET_CACHE_UP")))
(deny file-write* (subpath (param "GIT_n")) (literal (param "HOME_GITCONFIG")) (subpath (param "HOME_GITCONFIG_DIR")))
(deny file-write-unlink (subpath (param "GIT_n")) (literal (param "HOME_GITCONFIG")) (subpath (param "HOME_GITCONFIG_DIR")))
(deny file-write* (literal (param "XCRUN_DB_n")))
(deny file-write-unlink (literal (param "XCRUN_DB_n")))
(deny file-write* (literal (param "WRITE_n")))
(deny file-write-unlink (literal (param "WRITE_n")))
(deny file-write* (literal (param "TICKET_CACHE")) (literal (param "TICKET_CACHE_UP")) (literal (param "HOME_ALLOW")))
(deny file-write-unlink (literal (param "TICKET_CACHE")) (literal (param "TICKET_CACHE_UP")) (literal (param "HOME_ALLOW")))
(deny file-write-create (require-all (subpath (param "WRITE_n")) (regex (param "DOTGIT_RE"))) (require-all (subpath (param "WRITE_n")) (regex (param "DOTGIT_RE"))))
(deny file-read* file-write* (literal (param "SLACKOFF_CREDENTIALS")))
(deny file-write-unlink (literal (param "SLACKOFF_CREDENTIALS")))
