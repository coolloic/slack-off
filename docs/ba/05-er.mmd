  REQUIREMENT ||--o{ DESIGN_DOC : "锁定版本"
  REQUIREMENT ||--o{ REVIEW_REPORT : "按此验收"
  SOLUTION ||--o{ CHOICE : "被选"
  DESIGN_DOC ||--o{ DEBATE_ROUND : "被挑刺"
  DEBATE_ROUND ||--o{ DEBATE_RULING : "分歧"
  REVIEW_REPORT ||--o{ REVIEW_EVIDENCE : "证据"
