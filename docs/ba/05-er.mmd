  REVIEW_REPORT ||--o{ REVIEW_DECISION : "据此决定"
  TICKET ||--o{ ACCEPTANCE_RUN : "验收进程（恢复清理）"
  TICKET ||--o{ DELIVERY : "确认并交付"
  REVIEW_REPORT ||--o{ DELIVERY : "据此交付"
  DELIVERY ||--o{ DELIVERY_STEP : "逐条步骤"
  TICKET ||--o{ JIRA_COMMENT : "JIRA 评论（需确认）"
  DELIVERY_STEP |o--o| JIRA_WRITE : "jira_status 步"
  DELIVERY_STEP |o--o| JIRA_COMMENT : "jira_comment 步"
